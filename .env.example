# Base URL of the vLLM-Omni server that serves Qwen-Image-2.1.
# Example: http://model-host:8000  or  http://gpu-box.lan:8080
QWEN_IMAGE_API=http://your-model-server:8000

# Optional: pin the model id. Empty = take the first id from /v1/models.
QWEN_IMAGE_MODEL=

# Optional: upstream timeout in seconds (generation is slow).
QWEN_IMAGE_TIMEOUT_S=900
